    "test": "node --test test/*.test.js",
    "demo": "node scripts/serve-demo.js"
  },
  "keywords": [
    "cli",
    "terminal",
    "progress",
    "bar",
    "visualization",
    "animation",
    "unicode",
    "compact",
    "compression"
  ],
