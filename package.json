{
  "name": "compact-viz",
  "version": "0.1.0",
  "description": "Animated compression progress visualizer for the terminal — Unicode bars, diagonal grids, wave effects",
  "main": "src/index.js",
  "bin": {
    "compact-viz": "./bin/compact-viz.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./themes": "./src/renderers/index.js"
  },
  "scripts": {
